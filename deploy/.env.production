# ============================================================
# Production Environment Variables
# Copy this to .env in the project root before deploying:
#   cp deploy/.env.production .env
# Then fill in the values below.
# ============================================================

# --- Domain name (used for CORS and nginx server_name) ---
DOMAIN_NAME=<your-domain>

# --- Public IP of your VM (used for DNS setup) ---
PUBLIC_IP=<your-vm-public-ip>

# --- JWT Secret (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=<generate-a-strong-secret>

# --- Google OAuth ---
GOOGLE_CLIENT_ID=<from-google-console>
GOOGLE_CLIENT_SECRET=<from-google-console>

# --- Encryption key for stored OAuth tokens ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<generate-a-fernet-key>

# --- Auto-admin emails (comma-separated) ---
ADMIN_EMAILS=<you@example.com>

# --- Email (Gmail SMTP) for verification + password reset ---
# Use a Gmail *app password* (Google Account -> Security -> 2-Step Verification -> App passwords), not your login password.
SMTP_USER=<your-gmail-address>
SMTP_PASSWORD=<gmail-app-password>
SMTP_FROM=<optional; defaults to SMTP_USER>
PUBLIC_URL=https://grindlogger.com

# --- GitHub OAuth ---
GH_CLIENT_ID=<from-github-oauth-app>
GH_CLIENT_SECRET=<from-github-oauth-app>

# --- Discord OAuth ---
DISCORD_CLIENT_ID=<from-discord-developer-portal>
DISCORD_CLIENT_SECRET=<from-discord-developer-portal>

# --- Reddit OAuth ---
REDDIT_CLIENT_ID=<from-reddit-prefs-apps>
REDDIT_CLIENT_SECRET=<from-reddit-prefs-apps>

# --- Anthropic API Key (for AI Coach, optional) ---
ANTHROPIC_API_KEY=<your-anthropic-key>

# --- PostgreSQL (stronger credentials for production) ---
POSTGRES_USER=workout
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=workout_tracker

# --- Cloudflare Tunnel (home hosting via docker-compose.home.yml) ---
# Zero Trust dashboard → Networks → Tunnels → your tunnel → Docker install command (the token after --token)
CLOUDFLARE_TUNNEL_TOKEN=<from-cloudflare-zero-trust>
